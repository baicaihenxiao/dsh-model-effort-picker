{
  "name": "dsh-model-effort-picker",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Composer model menu that opens on the model list, plus a reasoning-effort slider.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "Model & effort picker",
    "description": "Opens the composer model list directly and puts reasoning effort on a slider beside the model control."
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
